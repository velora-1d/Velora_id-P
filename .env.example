# ==========================================
# VELORA ID - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env.production untuk deployment
# ==========================================

# Server & Network
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=disable
DATABASE_URL=postgresql://db-velora:your_password@your_host:5435/db-velora

# Object Storage (RustFS / S3 Compatible / Supabase)
SUPABASE_S3_ENDPOINT=https://your-s3-endpoint.domain.com
SUPABASE_STORAGE_BUCKET=velora-assets
SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SUPABASE_STORAGE_PUBLIC_URL=https://your-public-storage.domain.com

# Analytics (Opsional)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
